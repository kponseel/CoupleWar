# --- Serveur CoupleWar (Node) ---
# Port d'écoute du service Node.
PORT=3001
# Interface d'écoute (127.0.0.1 derrière Nginx en prod ; 0.0.0.0 en dev/LAN).
HOST=0.0.0.0
# Origines CORS autorisées (séparées par des virgules). En dev : le front Vite.
CORS_ORIGINS=http://localhost:5173
# Sert le front buildé (client/dist) en same-origin. true en prod.
SERVE_STATIC=false
# Chemin de la config centralisée (défaut: config/game.config.json).
# COUPLEWAR_CONFIG_PATH=config/game.config.json
# Répertoire du contenu seed (défaut: content/).
# COUPLEWAR_CONTENT_DIR=content

# --- Client (Vite), à mettre dans client/.env.local si besoin ---
# URL du serveur si différent de l'origine (sinon laisser vide : same-origin / proxy dev).
# VITE_SERVER_URL=
